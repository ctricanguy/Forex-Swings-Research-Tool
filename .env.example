# Copy to .env and fill in. Never commit the real .env (it is gitignored).
# These environment variables override values in config/config.yaml.

# --- OANDA v20 (data + optional execution) ---
# Create a token at: OANDA account -> Manage API Access.
OANDA_ACCESS_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice          # practice (demo) or live

# --- Telegram alerts ---
# Get a bot token from @BotFather; get your chat id from a helper bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
FOREX_DB_PATH=forex.db
